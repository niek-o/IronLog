# Copy this file to .env and adjust values before running docker compose.
POSTGRES_DB=fitnesstracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Generate a long random string for production, e.g.: openssl rand -base64 48
JWT_KEY=dev-only-change-this-secret-key-before-deploying-1234567890

ASPNETCORE_ENVIRONMENT=Production

# --- Production deployment via docker-compose.prod.yml (Traefik) ---
# Keep Swagger off in production unless you specifically need it exposed.
ENABLE_SWAGGER=false
